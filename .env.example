# Copy this file to .env and add your real keys.
# .env is git-ignored — never commit real keys.

# ============================================
# API KEYS (Required)
# ============================================

# OpenAI — get from https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY_HERE

# Anthropic — get from https://console.anthropic.com
VITE_ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE

# ============================================
# AUTHENTICATION
# ============================================

# Default login credentials for Alpha-Gen
VITE_AUTH_USER=xnorphic
VITE_AUTH_PASS=!Welcome1234

# ============================================
# API ENDPOINTS
# ============================================

VITE_ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
VITE_OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# ============================================
# MODEL SELECTION
# ============================================

# Anthropic Claude models
VITE_ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
VITE_ANTHROPIC_MODEL_DEEP=claude-sonnet-4-20250514

# OpenAI models
VITE_OPENAI_MODEL=gpt-4o-mini

# ============================================
# TRADING PARAMETERS
# ============================================

# Fixed transaction cost per trade (USD)
VITE_TRANSACTION_COST=2

# Minimum trade size (USD)
VITE_MIN_TRADE_SIZE=25

# ============================================
# SYSTEM PROMPT
# ============================================

# Instruction prompt for AI models
VITE_SYSTEM_PROMPT=You are a quantitative analyst. Return ONLY valid JSON. No markdown. No text outside the JSON object. Start with { end with }. No trailing commas. No newlines inside string values.
